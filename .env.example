# Copiar somente os valores públicos necessários para o ambiente do processo.
# Este arquivo não é carregado automaticamente.
CANTEIRO_ENV=development
CANTEIRO_BIND_ADDR=127.0.0.1:3000
CANTEIRO_SITE_ROOT=target/site
# Injetar CANTEIRO_DATABASE_URL no processo do servidor, fora do repositório.
# O processo separado canteiro-db migrate também recebe CANTEIRO_MIGRATION_DATABASE_URL.
# O servidor não recebe a credencial de migração. Não há autenticação nem atos comerciais nesta etapa.
