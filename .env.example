# Copiar somente os valores públicos necessários para o ambiente do processo.
# Este arquivo não é carregado automaticamente.
CANTEIRO_ENV=development
CANTEIRO_BIND_ADDR=127.0.0.1:3000
CANTEIRO_SITE_ROOT=target/site
# Injetar CANTEIRO_DATABASE_URL no processo do servidor, fora do repositório.
# O processo separado canteiro-db migrate também recebe CANTEIRO_MIGRATION_DATABASE_URL.
# O servidor não recebe a credencial de migração.
# Injetar CANTEIRO_AUTH_KEY (32 bytes aleatórios, base64url sem padding).
# Nunca colocar a chave ou a credencial do e-mail neste arquivo.
CANTEIRO_PUBLIC_ORIGIN=http://127.0.0.1:3000
# O envio usa a API Resend e um remetente já verificado nesse provedor.
# Injetar CANTEIRO_AUTH_MAIL_CREDENTIAL e CANTEIRO_AUTH_MAIL_FROM externamente.
# CANTEIRO_AUTH_MAIL_ENDPOINT é opcional; padrão https://api.resend.com/emails.
# Homologação exige HTTPS e e-mail configurado. Consulte docs/seguranca-acesso.md.
